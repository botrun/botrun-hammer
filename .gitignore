# 環境變數（包含 API Key）
.env
*.env
!.env.example

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# 暫存檔
*.wav
*.mp3
*.m4a
/tmp/

# 編輯器
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node（如果未來加入）
node_modules/

# 本地開發用腳本
sh/
scripts/*
# v1.7.0+：以下 daemon 檔案需要分發給使用者，不忽略（gitignore re-include
# 只在父目錄沒整個被 exclude 時才生效，所以上面用 scripts/* 而非 scripts/）
!scripts/lwm_daemon.py
!scripts/lwm_daemon_ctl.sh
!scripts/test_lwm_daemon.sh
!scripts/test_uv_install.sh
# v1.12.0：補轉未完成錄音的 BDD E2E 驗收腳本
!scripts/test_retranscribe.sh
# v1.9.0: ASR benchmark — 可重現腳本 + ground truth（wav 由 generate_reference.sh 重產，不入版控）
!scripts/asr_benchmark/
!scripts/asr_benchmark/*.py
!scripts/asr_benchmark/*.sh
!scripts/asr_benchmark/*.txt

# 日誌
*.log

# 本機模型 cache（GB 級，絕不要進版控）
mlx_models/
*.mlx
*.safetensors
docs/test-logs/
